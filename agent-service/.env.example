# ── ramya agent harness (beta) · env template ─────────────────────────────
# copy to .env for local dev. on render/railway/fly set these in the dashboard.
# never commit real keys. the next.js site never sees these — it only holds
# PYTHON_AGENT_URL + CHAT_BACKEND_SECRET (server-side).

# llm — nvidia nim (openai-compatible chat-completions).
# hosted base: https://integrate.api.nvidia.com/v1
# NEVER paste real keys here — set them in the host dashboard / .env only.
# (a previously shared key must be treated as compromised — rotate it in the
# nvidia dashboard before deploying.)
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-ai/deepseek-v4-flash-0731

# jina fast path for small search/extract tasks (optional).
# unset = anonymous limits (still works, slower). never commit a real key.
JINA_API_KEY=

# scrapling extraction — static first; browser escalation is opt-in
# (needs headless deps + ram on the host; default off for v1).
SCRAPL_ALLOW_BROWSER=0
SCRAPL_BROWSER_PAGES=2

# shared secret — the next.js /api/chat proxy must send
# `authorization: bearer <this>` on every call. unset = allow (local dev only).
BACKEND_SECRET=
# site origin for cors (local dev + production, comma-separated allowed)
SITE_ORIGIN=http://localhost:3000,https://ramyaai.tech

# loop budgets (override per deploy if research runs too long/costly)
AGENT_WALL_TIME_S=120
AGENT_MAX_QUERIES=6
AGENT_MAX_PAGES=8
AGENT_MAX_QUESTIONS=3
AGENT_MAX_DECIDE_STEPS=8
