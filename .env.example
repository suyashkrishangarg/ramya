# ── ramya ai · environment template ─────────────────────────────────────────
# copy to .env.local for local dev, and add these in vercel → settings → env vars

# database (turso) — create a free db at https://turso.dev
# for local dev you may leave BOTH unset → a file database (local.db) is used
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# session signing secret — generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# google oauth (real "continue with google" sign-up)
# setup walkthrough in README → step 2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# admin console at /admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# google sheets realtime mirror — apps script web app url (README → step 3)
SHEETS_WEBAPP_URL=

# public site url (used for seo/og + oauth redirects)
NEXT_PUBLIC_SITE_URL=https://ramyaai.tech
