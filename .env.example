# ── ramya ai · environment template ─────────────────────────────────────────
# copy to .env.local for local dev, and add these in vercel → settings → env vars

# supabase (production database + real google sign-up) — see README steps 1–2
# project url            → supabase dashboard → settings → api
NEXT_PUBLIC_SUPABASE_URL=
# anon / public key      → supabase dashboard → settings → api
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# postgres connection    → supabase dashboard → connect → session pooler uri
DATABASE_URL=

# session signing secret — generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# admin console at /admin (stored only in env — rotate after launch)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# google sheets realtime mirror — apps script web app url (README step 3)
SHEETS_WEBAPP_URL=

# public site url (seo/og)
NEXT_PUBLIC_SITE_URL=https://ramyaai.tech

# welcome email ("thanks for showing interest in ramya") — via resend, free tier
#   1. sign up at resend.com → api keys → create key → paste it below
#   2. no company email needed to start: while your own domain is unverified,
#      resend delivers only to the address you registered with (sender:
#      onboarding@resend.dev) — enough to test the full signup flow
#   3. once you have a domain: resend → domains → add + verify dns, then set
#      EMAIL_FROM="ramya ai <hello@yourdomain.com>" and every signup gets it
#   left unset → emails are skipped and logged, waitlist keeps working
RESEND_API_KEY=
EMAIL_FROM=
