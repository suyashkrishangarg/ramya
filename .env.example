# ── ramya ai · environment template ─────────────────────────────────────────
# copy to .env.local for local dev, and add these in vercel → settings → env vars

# supabase (production database + real google sign-up) — see README steps 1–2
# project url            → supabase dashboard → settings → api
NEXT_PUBLIC_SUPABASE_URL=
# anon / public key      → supabase dashboard → settings → api
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# postgres connection    → supabase dashboard → connect → session pooler uri
DATABASE_URL=

# session signing secret — generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# admin console at /admin (stored only in env — rotate after launch)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# google sheets realtime mirror — apps script web app url (README step 3)
SHEETS_WEBAPP_URL=

# public site url (seo/og)
NEXT_PUBLIC_SITE_URL=https://ramyaai.tech
