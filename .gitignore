# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev database (libsql + embedded postgres)
local.db*
*.db
!*.db.ts
.pglite/

# local test logs
server.log
build.log

# pitch deck + large media must never ship in the repo
ramya presentation.pdf
*.mp4

# keep the env example tracked
!.env.example
node_modules

server-test*.log
server-dev*.log
